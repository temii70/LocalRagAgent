# Copy to .env and generate a private key before starting. Never publish .env.
# No stable image tag was recorded in this repository. main is a mutable fallback;
# replace it with a tested upstream release tag or digest for reproducible runs.
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Leave empty here. Generate 32 random bytes (64 hex characters) as in the setup guide.
WEBUI_SECRET_KEY=
